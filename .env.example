# Copy this file to `.env` and fill in your MT5 DEMO account credentials.
# `.env` is gitignored — NEVER commit real credentials (README §9).
# DEMO ACCOUNT ONLY. Never use a live-funded account during development.

# --- MT5 demo credentials (leave blank until you have a demo account) ---
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=

# --- Dummy placeholders (UI demo only — these do NOT connect to anything) ---
# Realistic-looking fakes so the dashboard shows the "credentials complete"
# indicator while backtesting on the mock broker. Replace MT5_* above with a
# REAL demo account before using live MT5 mode.
DUMMY_MT5_LOGIN=5012345678
DUMMY_MT5_PASSWORD=Demo-Pass123
DUMMY_MT5_SERVER=MetaQuotes-Demo

# --- Live order routing (backtests ALWAYS use the mock) ---
#   mock       = paper orders to the in-process simulated broker (no MT5)
#   remote_mt5 = RPC to the MT5 host (native Windows running src/execution/mt5_service.py)
#   mt5        = direct MetaTrader5 (only on the Windows host itself)
EXECUTION_HANDLER=mock

# --- RPC boundary to the MT5 host (used by remote_mt5) ---
# MT5_RPC_HOST=mt5
# MT5_RPC_PORT=9099
# Shared secret: set the SAME value on the engine and on the MT5 host. Plain TCP,
# so also keep the port private (LAN / VPN / SSH tunnel).
MT5_RPC_TOKEN=

# --- Optional engine overrides (defaults live in config/settings.py) ---
# VOLUME_ZSCORE_THRESHOLD=1.5
# ML_CONFIDENCE_THRESHOLD=0.55
# ZSCORE_WINDOW=20
# RISK_FRACTION_PER_TRADE=0.01
# STARTING_EQUITY=10000
# DEFAULT_STOP_LOSS_PCT=0.012
# DEFAULT_TAKE_PROFIT_PCT=0.004
# USE_TIME_EXIT=false
# LABEL_DYNAMIC_SL=false
# ALLOW_SHORTS=true
# LOG_LEVEL=INFO
